# Optional. A Formspree / Netlify / own-backend URL that accepts a JSON POST.
# While unset, the contact form opens the visitor's email app instead.
VITE_FORM_ENDPOINT=

# The final public origin, no trailing slash (e.g. https://example.com).
# Drives canonical URLs, Open Graph URLs, structured data, sitemap.xml and robots.txt.
VITE_SITE_URL=
